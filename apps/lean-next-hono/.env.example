# 必須: `npm run build` / `next dev` ともプール生成時に参照されます（MySQL 未起動でも URL 文字列は必要）
DATABASE_URL=mysql://root:leanroot@127.0.0.1:3307/lean_app

# Auth.js v5（`AUTH_*` 推奨。未設定時は NEXTAUTH_* をフォールバック）
AUTH_SECRET=generate-a-long-random-string
AUTH_URL=http://localhost:3000

NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=generate-a-long-random-string

# サーバー側の絶対 URL が必要なとき（省略時は開発では 127.0.0.1:3000）
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- REST JWT（性能テスト整合。省略時は AUTH_SECRET / NEXTAUTH_SECRET で署名） ---
# JWT_SECRET=
# JWT_ACCESS_EXP_MINUTES=15
# JWT_REFRESH_EXP_DAYS=7
