BIND_ADDR=127.0.0.1:8080
JWT_SECRET=dev-insecure-change-me
# Access JWT の有効期限（分）。既定 15。
JWT_ACCESS_EXP_MINUTES=15
# Refresh トークン有効期限（日）。既定 7。
JWT_REFRESH_EXP_DAYS=7
# tower-sessions → Dragonfly / Redis（compose の dragonfly:6379 と整合）
SESSION_REDIS_URL=redis://127.0.0.1:6379
SESSION_REDIS_KEY_PREFIX=perf:sess:
# P4b: items 一覧ページの Dragonfly/Redis read-through（既定 true）。無効化は PERF_CACHE_LIST_ENABLED=false
PERF_CACHE_LIST_ENABLED=true
# 未設定時は SESSION_REDIS_URL / REDIS_URL と同じ
# PERF_CACHE_REDIS_URL=redis://127.0.0.1:6379
PERF_CACHE_KEY_PREFIX=perf:wt:
PERF_CACHE_LIST_TTL_SECS=300
MYSQL_URL=mysql://root:perfroot@127.0.0.1:3306/perf_meta
DYNAMODB_ENDPOINT=http://127.0.0.1:8000
DYNAMODB_TABLE=perf_items
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=alternator
AWS_SECRET_ACCESS_KEY=alternator
GRAPHQL_MAX_DEPTH=16
GRAPHQL_MAX_COMPLEXITY=256
GRAPHQL_APQ_CACHE_SIZE=512
# Arrow バイナリ応答（operationName ItemsArrowBinary）の最大バイト。0 = 無制限扱い。
ARROW_BINARY_MAX_BYTES=0
